nver')=18) AS \"18\", avg(arrivals) FILTER (WHERE extract(hour FROM timestamp AT TIME ZONE 'America/Denver')=19) AS \"19\", avg(arrivals) FILTER (WHERE extract(hour FROM timestamp AT TIME ZONE 'America/Denver')=20) AS \"20\", avg(arrivals) FILTER (WHERE extract(hour FROM timestamp AT TIME ZONE 'America/Denver')=21) AS \"21\", avg(arrivals) FILTER (WHERE extract(hour FROM timestamp AT TIME ZONE 'America/Denver')=22) AS \"22\", avg(arrivals) FILTER (WHERE extract(hour FROM timestamp AT TIME ZONE 'America/Denver')=23) AS \"23\" FROM hourly_demand WHERE dataset_id = ${dataset:sqlstring} GROUP BY 1,extract(isodow FROM timestamp AT TIME ZONE 'America/Denver') ORDER BY extract(isodow FROM timestamp AT TIME ZONE 'America/Denver')"
