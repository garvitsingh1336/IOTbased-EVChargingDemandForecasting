      {
        "name": "dataset",
        "label": "Dataset",
        "type": "query",
        "datasource": {
          "type": "postgres",
          "uid": "evforecast-postgres"
        },
        "query": "SELECT quality->>'site_name' AS __text,dataset_id AS __value FROM datasets WHERE site_id='boulder-carpenter-park' ORDER BY created_at DESC",
        "definition": "SELECT quality->>'site_name' AS __text,dataset_id AS __value FROM datasets WHERE site_id='boulder-carpenter-park' ORDER BY created_at DESC",
        "refresh": 1,
        "multi": false,
        "includeAll": false,
        "sort": 0,
        "options": []
      },
      {
        "name": "forecast",
        "label": "Forecast Run",
        "type": "query",
        "datasource": {
          "type": "postgres",
          "uid": "evforecast-postgres"
        },
        "query": "SELECT to_char(origin AT TIME ZONE site_timezone,'DD Mon YYYY HH24:MI') || ' · ' || left(forecast_id,8) AS __text,forecast_id AS __value FROM forecast_runs WHERE dataset_id=${dataset:sqlstring} ORDER BY created_at DESC",
        "definition": "SELECT to_char(origin AT TIME ZONE site_timezone,'DD Mon YYYY HH24:MI') || ' · ' || left(forecast_id,8) AS __text,forecast_id AS __value FROM forecast_runs WHERE dataset_id=${dataset:sqlstring} ORDER BY created_at DESC",
        "refresh": 1,
        "multi": false,
        "includeAll": false,
        "sort": 0,
        "options": []
      },
      {
        "name": "replay",
        "label": "Replay Run",
        "type": "query",
        "datasource": {
          "type": "postgres",
          "uid": "evforecast-postgres"
        },
        "query": "SELECT run_id AS __text,run_id AS __value FROM replay_runs ORDER BY created_at DESC",
        "definition": "SELECT run_id AS __text,run_id AS __value FROM replay_runs ORDER BY created_at DESC",
        "refresh": 1,
