          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT to_char(timestamp AT TIME ZONE 'America/Denver','Dy') AS \"Day\", avg(arrivals) FILTER (WHERE extract(hour FROM timestamp AT TIME ZONE 'America/Denver')=0) AS \"00\", avg(arrivals) FILTER (WHERE extract(hour FROM timestamp AT TIME ZONE 'America/Denver')=1) AS \"01\", avg(arrivals) FILTER (WHERE extract(hour FROM timestamp AT TIME ZONE 'America/Denver')=2) AS \"02\", avg(arrivals) FILTER (WHERE extract(hour FROM timestamp AT TIME ZONE 'America/Denver')=3) AS \"03\", avg(arrivals) FILTER (WHERE extract(hour FROM timestamp AT TIME ZONE 'America/Denver')=4) AS \"04\", avg(arrivals) FILTER (WHERE extract(hour FROM timestamp AT TIME ZONE 'America/Denver')=5) AS \"05\", avg(arrivals) FILTER (WHERE extract(hour FROM timestamp AT TIME ZONE 'America/Denver')=6) AS \"06\", avg(arrivals) FILTER (WHERE extract(hour FROM timestamp AT TIME ZONE 'America/Denver')=7) AS \"07\", avg(arrivals) FILTER (WHERE extract(hour FROM timestamp AT TIME ZONE 'America/Denver')=8) AS \"08\", avg(arrivals) FILTER (WHERE extract(hour FROM timestamp AT TIME ZONE 'America/Denver')=9) AS \"09\", avg(arrivals) FILTER (WHERE extract(hour FROM timestamp AT TIME ZONE 'America/Denver')=10) AS \"10\", avg(arrivals) FILTER (WHERE extract(hour FROM timestamp AT TIME ZONE 'America/Denver')=11) AS \"11\", avg(arrivals) FILTER (WHERE extract(hour FROM timestamp AT TIME ZONE 'America/Denver')=12) AS \"12\", avg(arrivals) FILTER (WHERE extract(hour FROM timestamp AT TIME ZONE 'America/Denver')=13) AS \"13\", avg(arrivals) FILTER (WHERE extract(hour FROM timestamp AT TIME ZONE 'America/Denver')=14) AS \"14\", avg(arrivals) FILTER (WHERE extract(hour FROM timestamp AT TIME ZONE 'America/Denver')=15) AS \"15\", avg(arrivals) FILTER (WHERE extract(hour FROM timestamp AT TIME ZONE 'America/Denver')=16) AS \"16\", avg(arrivals) FILTER (WHERE extract(hour FROM timestamp AT TIME ZONE 'America/Denver')=17) AS \"17\", avg(arrivals) FILTER (WHERE extract(hour FROM timestamp AT TIME ZONE 'America/Denver')=18) AS \"18\", avg(arrivals) FILTER (WHERE extract(hour FROM timestamp AT TIME ZONE 'America/Denver')=19) AS \"19\", avg(arrivals) FILTER (WHERE extract(hour FROM timestamp AT TIME ZONE 'America/Denver')=20) AS \"20\", avg(arrivals) FILTER (WHERE extract(hour FROM timestamp AT TIME ZONE 'America/Denver')=21) AS \"21\", avg(arrivals) FILTER (WHERE extract(hour FROM timestamp AT TIME ZONE 'America/Denver')=22) AS \"22\", avg(arrivals) FILTER (WHERE extract(hour FROM timestamp AT TIME ZONE 'America/Denver')=23) AS \"23\" FROM hourly_demand WHERE dataset_id = ${dataset:sqlstring} GROUP BY 1,extract(isodow FROM timestamp AT TIME ZONE 'America/Denver') ORDER BY extract(isodow FROM timestamp AT TIME ZONE 'America/Denver')"
        }
      ]
