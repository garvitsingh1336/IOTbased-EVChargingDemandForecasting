          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT to_char(p.timestamp AT TIME ZONE f.site_timezone,'DD Mon HH24:MI') AS \"Local hour\", h.arrivals AS \"Actual\", p.prediction AS \"Forecast\" FROM forecast_points p JOIN forecast_runs f ON f.forecast_id = p.forecast_id LEFT JOIN hourly_demand h ON h.dataset_id = f.dataset_id AND h.timestamp = p.timestamp WHERE p.forecast_id = ${forecast:sqlstring} ORDER BY p.timestamp"
